# ============================================================
# EPGenius Rewriter V2
# ============================================================
#
# IMPORTANT:
# - This file is a TEMPLATE only.
# - Do NOT put real usernames, passwords, or private provider
#   URLs in this file.
# - Copy this file to .env and fill in your real values.
#
# Each provider has:
#   - One source M3U
#   - One EPG
#   - One or more provider URLs
#   - One or more accounts
#
# Each account can select which provider URL from the pool
# it should use.
# ============================================================


# ============================================================
# PROVIDER 1
# ============================================================

PROVIDER1_NAME=Dream 4K / Eagle 4K

# Source playlist downloaded by the rewriter.
PROVIDER1_M3U_URL=https://example.com/provider1.m3u

# Source EPG downloaded by the rewriter.
PROVIDER1_EPG_URL=https://example.com/provider1.xml.gz

# Number of provider URLs available in the pool.
PROVIDER1_URL_COUNT=2

# Provider URL 1.
PROVIDER1_URL=https://provider-url-1.example

# Provider URL 2.
PROVIDER1_URL2=https://provider-url-2.example

# Number of accounts for this provider.
PROVIDER1_ACCOUNT_COUNT=4

# ---------- Provider 1 / Account 1 ----------

PROVIDER1_ACCOUNT1_NAME=Dream Account 1
PROVIDER1_ACCOUNT1_USERNAME=YOUR_USERNAME
PROVIDER1_ACCOUNT1_PASSWORD=YOUR_PASSWORD
PROVIDER1_ACCOUNT1_OUTPUT=/data/dream/account1/playlist.m3u
PROVIDER1_ACCOUNT1_URL=1

# ---------- Provider 1 / Account 2 ----------

PROVIDER1_ACCOUNT2_NAME=Dream Account 2
PROVIDER1_ACCOUNT2_USERNAME=YOUR_USERNAME
PROVIDER1_ACCOUNT2_PASSWORD=YOUR_PASSWORD
PROVIDER1_ACCOUNT2_OUTPUT=/data/dream/account2/playlist.m3u
PROVIDER1_ACCOUNT2_URL=1

# ---------- Provider 1 / Account 3 ----------

PROVIDER1_ACCOUNT3_NAME=Dream Account 3
PROVIDER1_ACCOUNT3_USERNAME=YOUR_USERNAME
PROVIDER1_ACCOUNT3_PASSWORD=YOUR_PASSWORD
PROVIDER1_ACCOUNT3_OUTPUT=/data/dream/account3/playlist.m3u
PROVIDER1_ACCOUNT3_URL=1

# ---------- Provider 1 / Account 4 ----------

PROVIDER1_ACCOUNT4_NAME=Dream Account 4
PROVIDER1_ACCOUNT4_USERNAME=YOUR_USERNAME
PROVIDER1_ACCOUNT4_PASSWORD=YOUR_PASSWORD
PROVIDER1_ACCOUNT4_OUTPUT=/data/dream/account4/playlist.m3u
PROVIDER1_ACCOUNT4_URL=1


# ============================================================
# PROVIDER 2
# ============================================================

PROVIDER2_NAME=Strong 8K

# Source playlist downloaded by the rewriter.
PROVIDER2_M3U_URL=https://example.com/provider2.m3u

# Source EPG downloaded by the rewriter.
PROVIDER2_EPG_URL=https://example.com/provider2.xml.gz

# Number of provider URLs available in the pool.
PROVIDER2_URL_COUNT=2

# Provider URL 1.
PROVIDER2_URL=https://provider-url-1.example

# Provider URL 2.
PROVIDER2_URL2=https://provider-url-2.example

# Number of accounts for this provider.
PROVIDER2_ACCOUNT_COUNT=5

# ---------- Provider 2 / Account 1 ----------

PROVIDER2_ACCOUNT1_NAME=Strong 8K Account 1
PROVIDER2_ACCOUNT1_USERNAME=YOUR_USERNAME
PROVIDER2_ACCOUNT1_PASSWORD=YOUR_PASSWORD
PROVIDER2_ACCOUNT1_OUTPUT=/data/8k/account1/playlist.m3u
PROVIDER2_ACCOUNT1_URL=1

# ---------- Provider 2 / Account 2 ----------

PROVIDER2_ACCOUNT2_NAME=Strong 8K Account 2
PROVIDER2_ACCOUNT2_USERNAME=YOUR_USERNAME
PROVIDER2_ACCOUNT2_PASSWORD=YOUR_PASSWORD
PROVIDER2_ACCOUNT2_OUTPUT=/data/8k/account2/playlist.m3u
PROVIDER2_ACCOUNT2_URL=1

# ---------- Provider 2 / Account 3 ----------

PROVIDER2_ACCOUNT3_NAME=Strong 8K Account 3
PROVIDER2_ACCOUNT3_USERNAME=YOUR_USERNAME
PROVIDER2_ACCOUNT3_PASSWORD=YOUR_PASSWORD
PROVIDER2_ACCOUNT3_OUTPUT=/data/8k/account3/playlist.m3u
PROVIDER2_ACCOUNT3_URL=1

# ---------- Provider 2 / Account 4 ----------

PROVIDER2_ACCOUNT4_NAME=Strong 8K Account 4
PROVIDER2_ACCOUNT4_USERNAME=YOUR_USERNAME
PROVIDER2_ACCOUNT4_PASSWORD=YOUR_PASSWORD
PROVIDER2_ACCOUNT4_OUTPUT=/data/8k/account4/playlist.m3u
PROVIDER2_ACCOUNT4_URL=2

# ---------- Provider 2 / Account 5 ----------

PROVIDER2_ACCOUNT5_NAME=Strong 8K Account 5
PROVIDER2_ACCOUNT5_USERNAME=YOUR_USERNAME
PROVIDER2_ACCOUNT5_PASSWORD=YOUR_PASSWORD
PROVIDER2_ACCOUNT5_OUTPUT=/data/8k/account5/playlist.m3u
PROVIDER2_ACCOUNT5_URL=2


# ============================================================
# GENERAL SETTINGS
# ============================================================

# Refresh interval in minutes.
REFRESH_MINUTES=15

# Local HTTP server port.
HTTP_PORT=8080

# Public base URL used when generating playlist/EPG URLs.
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example

# URL-encode username/password when constructing provider
# playback URLs.
URL_ENCODE_CREDENTIALS=true