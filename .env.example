# EPGenius files
# Use the Google Drive share/download URL for the EPGenius M3U.
EPGENIUS_M3U_URL=https://drive.google.com/file/d/PUT_M3U_FILE_ID_HERE/view

# Use the Google Drive share/download URL for the EPGenius EPG.
EPGENIUS_EPG_URL=https://drive.google.com/file/d/PUT_EPG_FILE_ID_HERE/view

# Your real IPTV provider credentials.
# Do NOT put these in the Python source.
PROVIDER_URL=https://your-provider.example
PROVIDER_USERNAME=YOUR_USERNAME
PROVIDER_PASSWORD=YOUR_PASSWORD

# Refresh EPGenius files every 15 minutes.
REFRESH_MINUTES=15

# Local HTTP server for TiviMate.
HTTP_PORT=8080

# URL that will be written into #EXTM3U url-tvg.
# If your VM LAN IP is 192.168.1.50, use:
# PUBLIC_BASE_URL=http://192.168.1.50:38090
PUBLIC_BASE_URL=http://YOUR_VM_IP:38090

# Keep the provider host from the downloaded EPGenius playlist,
# but replace username/password. Set true if you want PROVIDER_URL
# to replace the original host too.
REPLACE_PROVIDER_URL=true

# URL-encode username/password when placing them in /live/user/pass/ URLs.
# Usually leave true.
URL_ENCODE_CREDENTIALS=true
